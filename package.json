{
  "name": "forgelex-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FORGELEX — Plataforma Agêntica Jurídica Agnóstica",
  "scripts": {
    "build": "pnpm -r --sort run build",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "lint:fix": "eslint apps packages --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "db:migrate": "pnpm build && node scripts/migrate-postgres.mjs",
    "test:postgres": "pnpm build && node scripts/smoke-postgres.mjs",
    "test:e2e:phase7": "playwright test tests/e2e/phase-7.spec.ts --project=chromium",
    "test:e2e:mcp-onboarding": "playwright test tests/e2e/mcp-onboarding.spec.ts --project=chromium",
    "test:e2e:public": "playwright test --config playwright.public.config.ts",
    "test:e2e:account-closure": "playwright test --config playwright.account-closure.config.ts",
    "test:postgres:account-closure": "pnpm build && node scripts/smoke-account-closure-postgres.mjs",
    "verify:account-closure-restore": "pnpm build && node scripts/verify-account-closure-restore.mjs",
    "verify:account-closure-preclosure-restore": "pnpm build && node scripts/verify-account-closure-preclosure-restore.mjs",
    "test:load:search": "pnpm build && node scripts/load-search.mjs",
    "ingest:stj": "pnpm build && node scripts/ingest-stj-open-data.mjs",
    "phase8:measure": "node scripts/phase8/measure-source.mjs",
    "phase8:export-stj": "node scripts/phase8/export-global-stj.mjs",
    "phase8:verify-corpus": "node scripts/phase8/verify-corpus.mjs",
    "phase8:seed-gate-a": "pnpm build && node scripts/phase8/seed-gate-a.mjs",
    "phase8:bootstrap-tenant": "pnpm build && node scripts/phase8/bootstrap-synthetic-tenant.mjs",
    "phase14:bootstrap-billing": "pnpm build && node scripts/phase14/bootstrap-billing-tenant.mjs",
    "phase8:smoke-remote": "node scripts/phase8/remote-http.mjs",
    "phase8:mcp-remote": "node scripts/phase8/mcp-client.mjs",
    "phase8:agent-core-remote": "pnpm build && node scripts/phase8/agent-core-remote.mjs"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.20.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.9",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "postgres": "^3.4.9",
    "prettier": "3.9.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
