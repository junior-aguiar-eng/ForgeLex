diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..2b5b355cfd9ce1629bc21d8509de5d3a41df2a96
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,16 @@
+'use strict';
+
+// ForgeLex mitigation for GHSA-vfj7-8cjw-p6xm. Validate iteratively before
+// entering recursive walkers, including callers that supply an AST directly.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  while (pending.length > 0) {
+    const [node, depth] = pending.pop();
+    if (depth > 100) {
+      throw new RangeError('Brace nesting exceeds maximum depth of 100');
+    }
+    if (node.nodes) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
