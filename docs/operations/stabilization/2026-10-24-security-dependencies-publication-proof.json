    "probeSha256": "c9142063a31e118db0ecd96c1ec292770e684ac6e8c44c3ed4746e147c1cc671",
    "probeSource": "const fs = require('node:fs');\nconst path = require('node:path');\nconst assert = require('node:assert/strict');\nconst { createRequire } = require('node:module');\nconst { pathToFileURL } = require('node:url');\n\nasync function main() {\n  const seen = new Set(), packages = [];\n  function walk(dir) {\n    const real = fs.realpathSync(dir);\n    if (seen.has(real)) return;\n    seen.add(real);\n    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n      const file = path.join(dir, entry.name);\n      if (entry.isDirectory()) walk(file);\n      else if (entry.isSymbolicLink()) { if (fs.statSync(file).isDirectory()) walk(file); }\n      else if (entry.name === 'package.json') {\n        const p = JSON.parse(fs.readFileSync(file));\n        if (p.name && p.version) packages.push({ name: p.name, version: p.version });\n      }\n    }\n  }\n  walk('/app/api/node_modules');\n  const selected = ['zod', 'fastify', 'fast-uri', 'body-parser', 'ip-address', 'hono', 'vitest', '@vitest/mocker'];\n  const affected = packages.filter(p => selected.includes(p.name));\n  assert(packages.length > 50);\n  assert(affected.some(p => p.name === 'zod' && p.version === '4.6.7'));\n  assert(affected.some(p => p.name === 'fastify' && p.version === '5.12.7'));\n  for (const p of affected) {\n    if (p.name === 'zod') assert.equal(p.version, '4.6.7');\n    if (p.name === 'fast-uri') assert(['3.1.9', '4.2.3'].includes(p.version));\n    if (p.name === 'body-parser') assert.equal(p.version, '2.4.0');\n    if (p.name === 'ip-address') assert.equal(p.version, '10.7.4');\n    assert(!['vitest', '@vitest/mocker'].includes(p.name));\n  }\n  const runtimeRequire = createRequire('/app/api/package.json');\n  const { z } = runtimeRequire('zod');\n  const oversized = z.array(z.object({ value: z.string() })).max(2)\n    .safeParse(Array.from({ length: 10_000 }, () => ({ value: 0 })));\n  assert.equal(oversized.success, false);\n  assert.equal(oversized.error.issues.length, 1);\n  assert(z.string().guid().safeParse('11111111-1111-1111-1111-111111111111').success);\n\n  function esmEntry(name) {\n    const dir = path.join('/app/api/node_modules', name);\n    const manifest = JSON.parse(fs.readFileSync(path.join(dir, 'package.json'), 'utf8'));\n    return pathToFileURL(path.resolve(dir, manifest.exports['.'].import)).href;\n  }\n  const { ToolRegistry } = await import(esmEntry('@forgelex/agent-core'));\n  const { searchCaseLawTool } = await import(esmEntry('@forgelex/legal-tools'));\n  const { McpHandler } = await import(esmEntry('@forgelex/mcp-server'));\n  const registry = new ToolRegistry(); registry.register(searchCaseLawTool);\n  // Catalog/initialize never access the ledger. No database or tool execution.\n  const handler = new McpHandler(registry, null);\n  const init = await handler.handleRequest({ jsonrpc: '2.0', id: 1, method: 'initialize' });\n  assert.equal(init.result.protocolVersion, '2024-11-05');\n  const catalog = await handler.handleRequest({ jsonrpc: '2.0', id: 2, method: 'tools/list' });\n  const search = catalog.result.tools.find(t => t.name === 'research.search_case_law');\n  assert.equal(search.inputSchema.type, 'object');\n  assert.equal(search.inputSchema.properties.limit.default, 10);\n  assert(search.inputSchema.required.includes('query'));\n  assert(!search.inputSchema.required.includes('limit'));\n  assert(!search.inputSchema.required.includes('idempotencyKey'));\n  assert.equal(search.inputSchema.properties.idempotencyKey.type, 'string');\n  assert.equal(search.inputSchema.additionalProperties, false);\n  assert.deepEqual(searchCaseLawTool.inputSchema.parse({ query: 'teste sintético' }), { query: 'teste sintético', limit: 10 });\n  assert.equal(searchCaseLawTool.inputSchema.safeParse({ query: 'teste', limit: 21 }).success, false);\n  console.log(JSON.stringify({ runtimePackagesInspected: packages.length, affectedPackages: affected,\n    oversizedArrayIssues: oversized.error.issues.length, legacyGuidAccepted: true,\n    mcpCatalogAndDefaultsVerified: true, databaseConnections: 0, billableCalls: 0, imageVerified: true }));\n}\nmain().catch(error => { console.error(error); process.exitCode = 1; });\n"
  },
