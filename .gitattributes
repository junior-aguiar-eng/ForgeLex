# Diff context markers and pnpm-generated header tabs are part of the patch.
patches/*.patch text eol=lf -whitespace
# Preserve the byte-exact, hash-pinned synthetic pilot fixture across platforms.
docs/architecture/fixtures/agentic-task6-synthetic-cases.json text eol=lf

# Preserve the bytes of the November calibration receipts and regression evidence.
docs/architecture/evidence/2026-11-0[12]-* -text whitespace=cr-at-eol
docs/architecture/evidence/2026-11-0[12]-*/** -text whitespace=cr-at-eol
# Raw test output is evidence; keep its original whitespace.
docs/architecture/evidence/2026-11-0[12]-*/**/*.log -whitespace
# Preserve raw evidence of the local editorial binding validation.
docs/architecture/evidence/2026-11-02-final-editor-contract/** -text -whitespace
docs/architecture/evidence/2026-11-03-editorial-binding/** -text -whitespace
# Preserve raw evidence of simulated editorial proposal generation.
